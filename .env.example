# SecureMed AI — Environment Configuration
# Copy this file to .env and fill in real values before running.

# LLM Provider: "ollama" (local) or "gemini" (cloud)
LLM_PROVIDER=gemini

# Gemini API key (required when LLM_PROVIDER=gemini)
# NOTE: this is a TEMPLATE — keep a placeholder here. Put the real key in .env (gitignored).
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama base URL (required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# AES-256 master key — use a strong random 32+ byte string in production
SECUREMED_MASTER_KEY=change_me_to_a_strong_random_secret_key_min_32_chars

# ── Authentication ───────────────────────────────────────────────────────────
# AUTH_MODE: "header" (dev, trusts X-User-ID) or "jwt" (validate Bearer tokens)
AUTH_MODE=header
# Secret used to sign session tokens (HS256). Falls back to SECUREMED_MASTER_KEY
# if blank. Set a dedicated strong random value in production.
SECUREMED_JWT_SECRET=
# Google OAuth Web Client ID — enables "Continue with Google" on the login page.
# Create at https://console.cloud.google.com/apis/credentials (OAuth client →
# Web application) and add your frontend origin to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
